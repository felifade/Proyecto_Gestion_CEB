# Credenciales de Google Cloud (Requerido para Google Drive y Picker API)
GOOGLE_CLIENT_ID=tu_cliente_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secret_aqui
GOOGLE_API_KEY=tu_api_key_de_google_picker_aqui

# API Key de Gemini (Opcional, también se puede configurar desde la UI)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Configuración del servidor y base de datos (Opcionales)
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_db
# SESSION_SECRET=un_secreto_aleatorio_muy_largo_y_seguro
